generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tickets {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  date        DateTime
  title       String       @db.VarChar(32)
  description String?      @db.VarChar(200)
  category    Categories[] @relation("tickets_categories")
  assigmentTo User?        @relation("assigment_to", fields: [assigmentId], references: [id])
  assigmentId String?      @map("assigment_id")
  createdBy   User?        @relation("created_by", fields: [createdById], references: [id])
  createdById String?      @map("created_by_id")

  status   Statuses? @relation(fields: [statusId], references: [id])
  statusId String?   @map("status_id")

  @@map("tickets")
}

model Statuses {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(32)
  color       String     @db.VarChar(16)
  description String?    @db.VarChar(200)
  tickets     Tickets[]
  settings    Settings[]

  @@map("statuses")
}

model Categories {
  id      String    @id @default(cuid())
  name    String    @db.VarChar(32)
  color   String
  tickets Tickets[] @relation("tickets_categories")

  @@map("categories")
}

model User {
  id              String    @id
  name            String    @db.VarChar(42)
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  isAdmin         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]
  ticketsAssigned Tickets[] @relation("assigment_to")
  ticketsCreated  Tickets[] @relation("created_by")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Settings {
  id              String    @id @default("global")
  defaultStatus   Statuses? @relation(fields: [defaultStatusId], references: [id])
  defaultStatusId String?   @map("default_status_id")

  @@map("settings")
}
